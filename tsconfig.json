{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "contracts/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "consumers/**/*.ts"
  ]
}

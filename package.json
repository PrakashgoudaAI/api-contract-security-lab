{
  "name": "api-contract-security-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/main.ts",
    "check": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "node --test tests/store.test.ts tests/auth.test.ts",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test:unit && npm test",
    "lint": "eslint .",
    "format": "prettier --write src tests contracts playwright.config.ts eslint.config.mjs",
    "format:check": "prettier --check src tests contracts playwright.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
